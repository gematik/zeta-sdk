# Template for the Android test client runtime configuration.
#
# Copy this file to `zeta.env` in the same folder and fill in the values.
#
# `zeta.env` and the referenced keystore (e.g. smcb-certificates.p12) are
# git-ignored on purpose - do NOT commit them, they contain local secrets.

ENVIRONMENTS=
FACHDIENST_URL=
SMB_KEYSTORE_FILE=
SMB_KEYSTORE_ALIAS=
SMB_KEYSTORE_PASSWORD=
DISABLE_SERVER_VALIDATION=
POPP_TOKEN=
WS_BASE_URL=
WS_SERVER_CONTEXT_PATH=
ASL_PROD=
RESOURCE_URL=
PUSH_GATEWAY_URL=
STORAGE_AES_KEY=
REQUIRED_ROLE_OID=

# Optional (Android only): path to a google-services.json to enable Firebase push
# notifications at build time. Leave empty/unset to keep the feature disabled.
ZETA_GOOGLE_SERVICES_JSON=
