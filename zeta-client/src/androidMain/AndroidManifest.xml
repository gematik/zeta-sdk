<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="de.gematik.zeta.client">

  <application
    android:name="de.gematik.zeta.client.ZetaClientApp"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.ZeroTrustTheme"
    tools:targetApi="31">
    <activity
      android:name="de.gematik.zeta.client.MainActivity"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:exported="true"
      android:theme="@style/Theme.ZeroTrustTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <activity
      android:name="de.gematik.zeta.client.data.service.oidc.OidcRedirectActivity"
      android:exported="true"
      android:launchMode="singleTop">

      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data android:scheme="de.gematik.zeta" />
        <data android:host="oidc" />
        <data android:host="app" />
      </intent-filter>
      
    </activity>
  </application>
</manifest>
